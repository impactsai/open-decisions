{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/impactsai/open-decisions/main/schemas/0.1.0-draft.1/bundle.schema.json",
  "title": "Open Decisions 0.1.0-draft.1 exchange bundle",
  "description": "A community draft. Schema validity is not evidence truth, trusted authority, payment execution, or settlement verification.",
  "type": "object",
  "properties": {
    "specVersion": {
      "const": "0.1.0-draft.1"
    },
    "protocol": {
      "$ref": "#/$defs/protocol"
    },
    "request": {
      "$ref": "#/$defs/request"
    },
    "evaluations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evaluation"
      },
      "minItems": 0
    },
    "decision": {
      "$ref": "#/$defs/decision"
    },
    "action": {
      "$ref": "#/$defs/action"
    },
    "authorization": {
      "$ref": "#/$defs/authorization"
    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "settlement": {
      "$ref": "#/$defs/settlement"
    },
    "integrity": {
      "type": "object",
      "properties": {
        "algorithm": {
          "const": "sha-256-jcs"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "algorithm",
        "digest"
      ],
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "format": "uri"
      },
      "additionalProperties": true
    }
  },
  "required": [
    "specVersion",
    "protocol",
    "request",
    "evaluations",
    "decision",
    "integrity"
  ],
  "additionalProperties": false,
  "$defs": {
    "reference": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uri"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "digest"
      ],
      "additionalProperties": false
    },
    "methodReference": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uri"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "digest"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uri"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "format": "uri"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "access": {
          "enum": [
            "public",
            "restricted",
            "withheld"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "digest",
        "mediaType",
        "source",
        "observedAt",
        "access",
        "description"
      ],
      "additionalProperties": false
    },
    "criterion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "requirement",
            "preference",
            "constraint"
          ]
        },
        "valueType": {
          "enum": [
            "boolean",
            "probability",
            "utility"
          ]
        },
        "method": {
          "$ref": "#/$defs/methodReference"
        }
      },
      "required": [
        "id",
        "label",
        "question",
        "role",
        "valueType",
        "method"
      ],
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "properties": {
        "criterionId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "acceptMinBp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "rejectMaxBp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      },
      "required": [
        "criterionId",
        "acceptMinBp",
        "rejectMaxBp"
      ],
      "additionalProperties": false
    },
    "weight": {
      "type": "object",
      "properties": {
        "criterionId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "weightBp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      },
      "required": [
        "criterionId",
        "weightBp"
      ],
      "additionalProperties": false
    },
    "scenario": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "massBp": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "weights": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/weight"
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "massBp",
        "weights"
      ],
      "additionalProperties": false
    },
    "protocol": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uri"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/criterion"
          },
          "minItems": 1
        },
        "method": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "const": "threshold-gates-v1"
                },
                "gates": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/gate"
                  },
                  "minItems": 1
                }
              },
              "required": [
                "id",
                "gates"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "const": "weighted-scenarios-v1"
                },
                "minimumTopShareBp": {
                  "type": "integer",
                  "minimum": 5001,
                  "maximum": 10000
                },
                "minimumLeadBp": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                }
              },
              "required": [
                "id",
                "minimumTopShareBp",
                "minimumLeadBp"
              ],
              "additionalProperties": false
            }
          ]
        },
        "authority": {
          "type": "object",
          "properties": {
            "determiner": {
              "type": "string",
              "format": "uri"
            },
            "basis": {
              "$ref": "#/$defs/reference"
            },
            "reviewContact": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "determiner",
            "basis",
            "reviewContact"
          ],
          "additionalProperties": false
        },
        "evidencePolicy": {
          "type": "object",
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1
            },
            "requiredEvidenceIds": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "description",
            "requiredEvidenceIds"
          ],
          "additionalProperties": false
        },
        "extensions": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "format": "uri"
          },
          "additionalProperties": true
        }
      },
      "required": [
        "id",
        "version",
        "title",
        "purpose",
        "criteria",
        "method",
        "authority",
        "evidencePolicy"
      ],
      "additionalProperties": false
    },
    "option": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uri"
        },
        "protocolRef": {
          "$ref": "#/$defs/reference"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "simulation",
            "live"
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          },
          "minItems": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 0
        },
        "scenarios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scenario"
          },
          "minItems": 1
        },
        "contextPolicy": {
          "type": "object",
          "properties": {
            "basis": {
              "type": "string",
              "minLength": 1
            },
            "allowedRecipients": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "retentionUntil": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            }
          },
          "required": [
            "basis",
            "allowedRecipients",
            "retentionUntil"
          ],
          "additionalProperties": false
        },
        "supersedes": {
          "$ref": "#/$defs/reference"
        },
        "extensions": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "format": "uri"
          },
          "additionalProperties": true
        },
        "disclosures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "actor": {
                "type": "string",
                "format": "uri"
              },
              "interest": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "actor",
              "interest"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "protocolRef",
        "createdAt",
        "purpose",
        "mode",
        "options",
        "evidence",
        "scenarios",
        "contextPolicy",
        "disclosures"
      ],
      "additionalProperties": false
    },
    "value": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "probability"
            },
            "probabilityBp": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "calibration": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "uncalibrated"
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "reported"
                    },
                    "report": {
                      "$ref": "#/$defs/reference"
                    }
                  },
                  "required": [
                    "status",
                    "report"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "kind",
            "probabilityBp",
            "calibration"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "utility"
            },
            "utilityBp": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          },
          "required": [
            "kind",
            "utilityBp"
          ],
          "additionalProperties": false
        }
      ]
    },
    "evaluation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uri"
        },
        "requestRef": {
          "$ref": "#/$defs/reference"
        },
        "scenarioId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "optionId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "criterionId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "evaluator": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uri"
            },
            "kind": {
              "enum": [
                "deterministic",
                "model",
                "human"
              ]
            },
            "method": {
              "$ref": "#/$defs/methodReference"
            }
          },
          "required": [
            "id",
            "kind",
            "method"
          ],
          "additionalProperties": false
        },
        "completedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "status": {
          "enum": [
            "complete",
            "unavailable",
            "error"
          ]
        },
        "value": {
          "$ref": "#/$defs/value"
        },
        "issue": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "code",
            "description"
          ],
          "additionalProperties": false
        },
        "extensions": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "format": "uri"
          },
          "additionalProperties": true
        }
      },
      "required": [
        "id",
        "requestRef",
        "scenarioId",
        "optionId",
        "criterionId",
        "evidenceIds",
        "evaluator",
        "completedAt",
        "status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "complete"
              }
            }
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "issue": false,
              "value": {}
            }
          },
          "else": {
            "required": [
              "issue"
            ],
            "properties": {
              "value": false,
              "issue": {}
            }
          }
        }
      ]
    },
    "ranking": {
      "type": "object",
      "properties": {
        "optionId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "soleFirstMassBp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "meanUtilityBp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      },
      "required": [
        "optionId",
        "soleFirstMassBp",
        "meanUtilityBp"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "outcome": {
          "enum": [
            "eligible",
            "not_eligible",
            "recommended",
            "no_viable_option",
            "review",
            "needs_information"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "selectedOptionId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "rankings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ranking"
          },
          "minItems": 0
        },
        "tieMassBp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "excludedOptionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "outcome",
        "reasons"
      ],
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uri"
        },
        "issuer": {
          "type": "string",
          "format": "uri"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "inputDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "result": {
          "$ref": "#/$defs/result"
        },
        "supersedes": {
          "$ref": "#/$defs/reference"
        },
        "extensions": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "format": "uri"
          },
          "additionalProperties": true
        }
      },
      "required": [
        "id",
        "issuer",
        "createdAt",
        "expiresAt",
        "inputDigest",
        "result"
      ],
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uri"
        },
        "decisionRef": {
          "$ref": "#/$defs/reference"
        },
        "mode": {
          "enum": [
            "simulation",
            "live"
          ]
        },
        "type": {
          "type": "string",
          "format": "uri"
        },
        "parameters": {
          "type": "object"
        },
        "executor": {
          "type": "string",
          "format": "uri"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1
        },
        "extensions": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "format": "uri"
          },
          "additionalProperties": true
        },
        "optionId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        }
      },
      "required": [
        "id",
        "decisionRef",
        "mode",
        "type",
        "parameters",
        "executor",
        "createdAt",
        "expiresAt",
        "idempotencyKey",
        "optionId"
      ],
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uri"
        },
        "actionRef": {
          "$ref": "#/$defs/reference"
        },
        "issuer": {
          "type": "string",
          "format": "uri"
        },
        "executor": {
          "type": "string",
          "format": "uri"
        },
        "status": {
          "enum": [
            "granted",
            "denied"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "authorityEvidence": {
          "$ref": "#/$defs/reference"
        },
        "extensions": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "format": "uri"
          },
          "additionalProperties": true
        }
      },
      "required": [
        "id",
        "actionRef",
        "issuer",
        "executor",
        "status",
        "createdAt",
        "expiresAt",
        "authorityEvidence"
      ],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uri"
        },
        "actionRef": {
          "$ref": "#/$defs/reference"
        },
        "authorizationRef": {
          "$ref": "#/$defs/reference"
        },
        "executor": {
          "type": "string",
          "format": "uri"
        },
        "mode": {
          "enum": [
            "simulation",
            "live"
          ]
        },
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "unknown"
          ]
        },
        "externalRef": {
          "$ref": "#/$defs/reference"
        },
        "extensions": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "format": "uri"
          },
          "additionalProperties": true
        }
      },
      "required": [
        "id",
        "actionRef",
        "authorizationRef",
        "executor",
        "mode",
        "startedAt",
        "completedAt",
