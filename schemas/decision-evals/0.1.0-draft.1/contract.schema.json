{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-decisions.org/schemas/decision-evals/0.1.0-draft.1/contract.schema.json",
  "title": "Decision Evals community draft",
  "$ref": "#/$defs/bundle",
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[\\s\\S]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "digest"
      ]
    },
    "kit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[\\s\\S]+$"
        },
        "version": {
          "type": "string",
          "pattern": "^[\\s\\S]+$"
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "mass": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "pattern": "^[\\s\\S]+$"
        },
        "ppm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      },
      "required": [
        "label",
        "ppm"
      ]
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[\\s\\S]+$"
        },
        "evaluatorKind": {
          "enum": [
            "model",
            "deterministic",
            "human"
          ]
        },
        "runtime": {
          "type": "string",
          "pattern": "^[\\s\\S]+$"
        },
        "modelRevision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[\\s\\S]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "revisionResolved": {
          "type": "boolean"
        },
        "quantization": {
          "type": "string",
          "pattern": "^[\\s\\S]+$"
        },
        "inferenceSettingsDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "promptTemplateDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rendererDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "orderingDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "batchingDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evidenceTransformDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "outputMappingDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scoreKind": {
          "enum": [
            "native-probabilities",
            "verbalized-probabilities",
            "logits",
            "score"
          ]
        }
      },
      "required": [
        "id",
        "evaluatorKind",
        "runtime",
        "modelRevision",
        "revisionResolved",
        "quantization",
        "inferenceSettingsDigest",
        "promptTemplateDigest",
        "rendererDigest",
        "orderingDigest",
        "batchingDigest",
        "evidenceTransformDigest",
        "outputMappingDigest",
        "scoreKind"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[\\s\\S]+$"
        },
        "stage": {
          "enum": [
            "fact",
            "determination"
          ]
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[\\s\\S]+$"
          },
          "minItems": 2,
          "maxItems": 10000
        },
        "positiveLabel": {
          "type": "string",
          "pattern": "^[\\s\\S]+$"
        },
        "adverseLabels": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[\\s\\S]+$"
          },
          "minItems": 0,
          "maxItems": 10000
        },
        "ordinalLevels": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "pattern": "^[\\s\\S]+$"
              },
              "level": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000
              }
            },
            "required": [
              "label",
              "level"
            ]
          },
          "minItems": 0,
          "maxItems": 10000
        }
      },
      "required": [
        "id",
        "stage",
        "labels",
        "positiveLabel",
        "adverseLabels"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "specVersion": {
          "const": "decision-evals/0.1.0-draft.1"
        },
        "kind": {
          "const": "evaluation-subject"
        },
        "kit": {
          "$ref": "#/$defs/kit"
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          },
          "minItems": 1,
          "maxItems": 10000
        },
        "configurations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/configuration"
          },
          "minItems": 1,
          "maxItems": 10000
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target"
          },
          "minItems": 1,
          "maxItems": 10000
        },
        "decisionMethod": {
          "$ref": "#/$defs/resource"
        },
        "acceptancePolicyDigest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "specVersion",
        "kind",
        "kit",
        "resources",
        "configurations",
        "targets",
        "decisionMethod",
        "acceptancePolicyDigest"
      ]
    },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targetId": {
          "type": "string",
          "pattern": "^[\\s\\S]+$"
        },
        "value": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[\\s\\S]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "enum": [
            "independent-adjudication",
            "independent-observation",
            "synthetic",
            "model",
            "decision-receipt"
          ]
        },
        "sourceDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "adjudicationMethod": {
          "type": "string",
          "pattern": "^[\\s\\S]+$"
        },
        "disagreement": {
          "type": "boolean"
        }
      },
      "required": [
        "targetId",
        "value",
        "source",
        "sourceDigest",
        "adjudicationMethod",
        "disagreement"
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[\\s\\S]+$"
        },
        "groupId": {
          "type": "string",
          "pattern": "^[\\s\\S]+$"
        },
        "split": {
          "enum": [
            "development",
            "fact-fit",
            "determination-fit",
            "acceptance"
          ]
        },
        "population": {
          "type": "string",
          "pattern": "^[\\s\\S]+$"
        },
        "stratum": {
          "type": "string",
          "pattern": "^[\\s\\S]+$"
        },
        "variant": {
          "type": "string",
          "pattern": "^[\\s\\S]+$"
        },
        "relation": {
          "enum": [
            "baseline",
            "meaning-preserving",
            "meaning-changing",
            "repeat",
            "failure"
          ]
        },
        "inputDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evidenceDigests": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "minItems": 0,
          "maxItems": 10000
        },
        "labels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/label"
          },
          "minItems": 1,
          "maxItems": 10000
        }
      },
      "required": [
        "id",
        "groupId",
        "split",
        "population",
        "stratum",
        "variant",
        "relation",
        "inputDigest",
        "evidenceDigests",
        "labels"
      ]
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "specVersion": {
          "const": "decision-evals/0.1.0-draft.1"
        },
        "kind": {
          "const": "benchmark-suite"
        },
        "id": {
          "type": "string",
          "pattern": "^[\\s\\S]+$"
        },
        "evaluationSubjectDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "frozenAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/case"
          },
          "minItems": 1,
          "maxItems": 10000
        },
        "requiredVariants": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[\\s\\S]+$"
          },
          "minItems": 1,
          "maxItems": 10000
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[\\s\\S]+$"
          },
          "minItems": 1,
          "maxItems": 10000
        }
      },
      "required": [
        "specVersion",
        "kind",
        "id",
        "evaluationSubjectDigest",
        "frozenAt",
        "cases",
        "requiredVariants",
        "limitations"
      ]
    },
    "prediction": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "native-probabilities",
                "verbalized-probabilities"
              ]
            },
            "distribution": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/mass"
              },
              "minItems": 2,
              "maxItems": 10000
            },
            "assertedLabel": {
              "type": "string",
              "pattern": "^[\\s\\S]+$"
            }
          },
          "required": [
            "kind",
            "distribution",
            "assertedLabel"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "logits",
                "score"
              ]
            },
            "values": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string",
                    "pattern": "^[\\s\\S]+$"
                  },
                  "decimal": {
                    "type": "string",
                    "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                  }
                },
                "required": [
                  "label",
                  "decimal"
                ]
              },
              "minItems": 1,
              "maxItems": 10000
            },
            "assertedLabel": {
              "type": "string",
              "pattern": "^[\\s\\S]+$"
            }
          },
          "required": [
            "kind",
            "values",
            "assertedLabel"
          ]
        }
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "caseId": {
          "type": "string",
          "pattern": "^[\\s\\S]+$"
        },
        "targetId": {
          "type": "string",
          "pattern": "^[\\s\\S]+$"
        },
        "configurationDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "enum": [
            "ok",
            "unavailable",
            "error",
            "invalid",
            "unattempted"
          ]
        },
        "prediction": {
          "anyOf": [
            {
              "$ref": "#/$defs/prediction"
            },
            {
              "type": "null"
            }
          ]
        },
        "issue": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[\\s\\S]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "renderedRequestDigest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "rawOutputDigest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "elapsedMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "costMicroUsd": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            {
              "type": "null"
            }
          ]
        },
        "costBasis": {
          "type": "string",
          "pattern": "^[\\s\\S]+$"
        }
      },
      "required": [
        "caseId",
        "targetId",
        "configurationDigest",
        "status",
        "prediction",
        "issue",
        "renderedRequestDigest",
        "rawOutputDigest",
        "attempts",
        "elapsedMs",
        "costMicroUsd",
        "costBasis"
      ]
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "specVersion": {
          "const": "decision-evals/0.1.0-draft.1"
        },
        "kind": {
          "const": "benchmark-run"
        },
        "id": {
          "type": "string",
          "pattern": "^[\\s\\S]+$"
        },
        "evaluationSubjectDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "suiteDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "configurationDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "runner": {
          "$ref": "#/$defs/resource"
        },
        "startedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
        },
        "completedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
        },
        "mode": {
          "enum": [
            "offline",
            "provider"
          ]
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          },
          "minItems": 1,
          "maxItems": 10000
        },
        "phase": {
          "enum": [
            "development",
            "fact-fit",
            "determination-fit",
            "acceptance"
          ]
        }
      },
      "required": [
        "specVersion",
        "kind",
        "id",
        "evaluationSubjectDigest",
        "suiteDigest",
        "configurationDigest",
        "runner",
        "startedAt",
        "completedAt",
        "mode",
        "observations",
        "phase"
      ]
    },
    "knot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inputPpm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "outputPpm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      },
      "required": [
        "inputPpm",
        "outputPpm"
      ]
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "pattern": "^[\\s\\S]+$"
        },
        "minimumPpm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "maximumPpm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "knots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/knot"
          },
          "minItems": 1,
          "maxItems": 10000
        }
      },
      "required": [
        "label",
        "minimumPpm",
        "maximumPpm",
        "knots"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "specVersion": {
          "const": "decision-evals/0.1.0-draft.1"
        },
        "kind": {
          "const": "calibration-artifact"
        },
        "evaluationSubjectDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "configurationDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "targetId": {
          "type": "string",
          "pattern": "^[\\s\\S]+$"
        },
        "stage": {
          "enum": [
            "fact",
            "determination"
          ]
        },
        "method": {
          "enum": [
            "binary-isotonic-pav-v1",
            "categorical-isotonic-normalized-v1",
            "identity-v1"
          ]
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[\\s\\S]+$"
          },
          "minItems": 2,
          "maxItems": 10000
        },
        "positiveLabel": {
          "type": "string",
          "pattern": "^[\\s\\S]+$"
        },
        "mappings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mapping"
          },
          "minItems": 0,
          "maxItems": 10000
        },
        "fitSuiteDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "fitRunDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "fitCaseIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[\\s\\S]+$"
          },
          "minItems": 1,
          "maxItems": 10000
        },
        "fitGroupIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[\\s\\S]+$"
          },
          "minItems": 1,
          "maxItems": 10000
        },
        "population": {
          "type": "string",
          "pattern": "^[\\s\\S]+$"
        },
        "strata": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[\\s\\S]+$"
          },
          "minItems": 1,
          "maxItems": 10000
        },
        "validFrom": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
        },
        "validUntil": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
        },
        "upstreamArtifactDigests": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "minItems": 0,
          "maxItems": 10000
        }
      },
      "required": [
        "specVersion",
        "kind",
        "evaluationSubjectDigest",
        "configurationDigest",
        "targetId",
        "stage",
        "method",
        "labels",
        "positiveLabel",
        "mappings",
        "fitSuiteDigest",
        "fitRunDigest",
        "fitCaseIds",
        "fitGroupIds",
        "population",
        "strata",
        "validFrom",
        "validUntil",
        "upstreamArtifactDigests"
      ]
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "valuePpm": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000000
            },
            {
              "type": "null"
            }
          ]
        },
        "n": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[\\s\\S]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "lowerPpm": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            {
              "type": "null"
            }
          ]
        },
        "upperPpm": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "valuePpm",
        "n",
        "reason",
        "lowerPpm",
        "upperPpm"
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accuracy": {
          "$ref": "#/$defs/metric"
        },
        "majorityBaseline": {
          "$ref": "#/$defs/metric"
        },
        "brier": {
          "$ref": "#/$defs/metric"
        },
        "logLoss": {
          "$ref": "#/$defs/metric"
        },
        "falseApproval": {
          "$ref": "#/$defs/metric"
        },
        "falseRejection": {
          "$ref": "#/$defs/metric"
        },
        "coverage": {
          "$ref": "#/$defs/metric"
        },
        "selectiveError": {
          "$ref": "#/$defs/metric"
        },
        "ece": {
          "$ref": "#/$defs/metric"
        },
        "ordinalMae": {
          "$ref": "#/$defs/metric"
        }
      },
      "required": [
        "accuracy",
        "majorityBaseline",
        "brier",
        "logLoss",
        "falseApproval",
        "falseRejection",
        "coverage",
        "selectiveError",
        "ece",
        "ordinalMae"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "specVersion": {
          "const": "decision-evals/0.1.0-draft.1"
        },
        "kind": {
          "const": "acceptance-policy"
        },
        "id": {
          "type": "string",
