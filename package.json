{
  "name": "open-decisions",
  "version": "0.3.0-draft.1",
  "private": true,
  "description": "A community draft for portable, evidence-based decision records",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "validate": "node tools/validate.mjs",
    "validate:udid": "node tools/validate-udid.mjs",
    "udid:examples": "node tools/check-udid-examples.mjs",
    "examples": "node tools/check-examples.mjs",
    "check": "npm test && npm run examples && npm run udid:examples && node tools/check-docs.mjs && node tools/build-comparison-validators.mjs --check && node tools/build-evals-validators.mjs --check && node tools/validate-evals.mjs examples/decision-evals/fictional-kit.json && node tools/build-evals-types.mjs --check",
    "comparison:generate": "node tools/build-comparison-validators.mjs",
    "evals:generate": "node tools/build-evals-validators.mjs && node tools/build-evals-types.mjs",
    "evals:validate": "node tools/validate-evals.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "canonicalize": "5.1.0"
  },
  "license": "MIT",
  "exports": {
    "./udid": "./udid/index.mjs",
    "./udid/schema": "./schemas/udid/2.0.0-draft.1/processed-claim-set.schema.json",
    "./udid/info-schema": "./schemas/udid/2.0.0-draft.1/udid-info.schema.json",
    "./comparison": {
      "types": "./comparison/index.d.ts",
      "default": "./comparison/index.mjs"
    },
    "./comparison/contracts": {
      "types": "./comparison/contracts.d.ts",
      "default": "./comparison/contracts.mjs"
    },
    "./comparison/schema": "./schemas/comparison/0.1.0-draft.1/contract.schema.json",
    "./evals": {
      "types": "./evals/index.d.ts",
      "default": "./evals/index.mjs"
    },
    "./evals/schema": "./schemas/decision-evals/0.1.0-draft.1/contract.schema.json"
  },
  "files": [
    "comparison",
    "evals",
    "udid",
    "tools/json.mjs",
    "schemas",
    "spec",
    "examples",
    "rfcs",
    "docs/decision-evals-implementation.md",
    "README.md",
    "GOVERNANCE.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
